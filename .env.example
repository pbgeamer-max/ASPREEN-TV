# ==============================================================================
# Aspreen TV — Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production

# Network & Host URLs
PORT=3001
HOST=0.0.0.0
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
PUBLIC_STREAM_BASE_URL=http://localhost:8080

# Next.js Public Client Configuration (Safe for browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Firebase Admin SDK Server-Only Credentials (NEVER expose to frontend!)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Security & Administrator Authorization
# Comma-separated list of Firebase UIDs authorized as administrators
ADMIN_AUTHORIZED_UIDS=abcdef1234567890abcdef123456

# Server Secrets & Cryptography
# 32-character minimum string for cookie signing
SESSION_SECRET=aspreen_super_secure_random_session_secret_change_me_in_prod_32ch

# 32-byte hexadecimal string for AES-256-GCM URL/credential encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret salt for HMAC SHA-256 stream token hashing
STREAM_TOKEN_SECRET=aspreen_stream_playback_token_salt_secret_change_in_prod

# Storage & Worker
STREAM_STORAGE_PATH=./data/hls
MAX_CONCURRENT_JOBS=8
MAX_PLAYLIST_CHANNELS=1000
SOURCE_TIMEOUT_SECONDS=15
SOURCE_CONNECT_TIMEOUT=10
